#!/usr/bin/env python3
"""Turn off chosen USB controllers while Steam Remote Play is streaming.

Steam hands out player slots in connection order, so a controller plugged into
this PC takes player 1 before the streaming client's controller arrives. This
watches Steam's logs and de-authorizes the configured USB devices when a stream
request is accepted, then re-authorizes them when the stream ends.

Devices are listed in ~/.config/remote-play-pad-guard/devices. Write access to
their `authorized` files comes from a udev rule; see --print-udev-rule.
"""

import argparse
import grp
import os
import re
import signal
import sys
import time
from pathlib import Path

POLL_SECONDS = 0.2
PENDING_TIMEOUT = 60  # accepted request that never becomes a stream
STEAM_CHECK_SECONDS = 5
EXIT_CONFIG = 2  # the service file does not restart on this one

# remote_connections.txt
ACCEPTED = re.compile(r"Responding to streaming request .*StreamingSuccess")
CANCELLED = re.compile(r"Received streaming cancel request")
# streaming_log.txt. Not "Stopped desktop stream": Steam also logs that when it
# switches from streaming the desktop to streaming the game.
STARTED = re.compile(r"\] Streaming started to ")
ENDED = re.compile(r"\] Encoding complete|PipeWire: Deinitializing streaming")

DEVICE_ID = re.compile(r"([0-9a-f]{4}):([0-9a-f]{4})")

IDLE, PENDING, STREAMING = "idle", "pending", "streaming"


def log(message):
    print(message, flush=True)


def config_error(message):
    print(message, file=sys.stderr, flush=True)
    sys.exit(EXIT_CONFIG)


def read_devices(path):
    """Return the (vendor, product) pairs listed in the config file."""
    try:
        text = path.read_text()
    except OSError as error:
        config_error(f"Could not read the device list: {error}")
    devices = []
    for number, line in enumerate(text.splitlines(), 1):
        line = line.split("#")[0].strip().lower()
        if not line:
            continue
        match = DEVICE_ID.fullmatch(line)
        if not match:
            config_error(f"{path}:{number}: expected an ID like 1234:abcd, got {line!r}")
        devices.append(match.groups())
    if not devices:
        config_error(f"{path} lists no devices")
    return devices


def print_udev_rule(devices):
    group = grp.getgrgid(os.getgid()).gr_name
    print(f'# Let the "{group}" group turn these USB devices on and off.')
    print("# Generated by remote-play-pad-guard --print-udev-rule.")
    for vendor, product in devices:
        print('ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", '
              f'ATTR{{idVendor}}=="{vendor}", ATTR{{idProduct}}=="{product}", '
              f'RUN+="/usr/bin/chgrp {group} /sys%p/authorized", '
              'RUN+="/usr/bin/chmod g+w /sys%p/authorized"')


class Tail:
    """Yield lines appended to a file, surviving rotation and truncation."""

    def __init__(self, path):
        self.path = path
        self.file = None
        self.partial = b""
        self._open(at_end=True)

    def _open(self, at_end):
        try:
            self.file = open(self.path, "rb")
        except OSError:
            self.file = None
            return
        if at_end:
            self.file.seek(0, os.SEEK_END)
        self.partial = b""

    def _read(self):
        data = self.partial + self.file.read()
        *lines, self.partial = data.split(b"\n")
        return [line.decode("utf-8", "replace") for line in lines]

    def lines(self):
        if self.file is None:
            self._open(at_end=False)
            return self._read() if self.file else []
        try:
            current = os.stat(self.path)
        except OSError:
            return self._read()
        opened = os.fstat(self.file.fileno())
        if (current.st_dev, current.st_ino) != (opened.st_dev, opened.st_ino):
            lines = self._read()  # whatever was written before the rotation
            self.file.close()
            self._open(at_end=False)
            return lines + (self._read() if self.file else [])
        if current.st_size < self.file.tell():
            self.file.seek(0)
            self.partial = b""
        return self._read()


class Guard:
    def __init__(self, device_ids, steam_dir, usb_dir, pid_file, pending_timeout):
        self.device_ids = device_ids
        self.usb_dir = usb_dir
        self.pid_file = pid_file
        self.pending_timeout = pending_timeout
        self.streaming_log = Tail(steam_dir / "logs/streaming_log.txt")
        self.connection_log = Tail(steam_dir / "logs/remote_connections.txt")
        self.state = IDLE
        self.pending_since = 0.0
        self.next_steam_check = 0.0

    def devices(self):
        for device in self.usb_dir.iterdir():
            try:
                device_id = ((device / "idVendor").read_text().strip(),
                             (device / "idProduct").read_text().strip())
            except OSError:
                continue  # interfaces have no ids; devices can vanish mid-scan
            if device_id in self.device_ids:
                yield device

    def set_pads(self, enabled):
        value = "1" if enabled else "0"
        word = "on" if enabled else "off"
        found = False
        for device in self.devices():
            found = True
            path = device / "authorized"
            try:
                if path.read_text().strip() == value:
                    continue
                path.write_text(value)
                log(f"Controller {word} ({device.name})")
            except OSError as error:
                log(f"Could not turn controller {word}: {error}")
        if not found and not enabled:
            log("No listed controller is plugged in; nothing to turn off")

    def set_state(self, state, reason):
        log(f"{self.state} -> {state}: {reason}")
        self.state = state
        if state == PENDING:
            self.pending_since = time.monotonic()
        self.set_pads(enabled=state == IDLE)

    def steam_running(self):
        try:
            pid = int(self.pid_file.read_text())
            comm = Path(f"/proc/{pid}/comm").read_text().strip()
        except (OSError, ValueError):
            return False
        return comm.startswith("steam")

    def step(self):
        # Streaming log first, so an old stream's end is seen before a new request.
        for line in self.streaming_log.lines():
            if STARTED.search(line):
                self.set_state(STREAMING, "stream started")
            elif self.state == STREAMING and ENDED.search(line):
                # Ignored while pending: that is an old stream closing after a
                # reconnect has already been accepted.
                self.set_state(IDLE, "stream ended")
        for line in self.connection_log.lines():
            if ACCEPTED.search(line):
                self.set_state(PENDING, "stream request accepted")
            elif self.state == PENDING and CANCELLED.search(line):
                self.set_state(IDLE, "stream request cancelled")

        now = time.monotonic()
        if self.state == PENDING and now - self.pending_since > self.pending_timeout:
            self.set_state(IDLE, "stream never started")
        if self.state != IDLE and now >= self.next_steam_check:
            self.next_steam_check = now + STEAM_CHECK_SECONDS
            if not self.steam_running():
                self.set_state(IDLE, "Steam is not running")

    def run(self):
        self.set_pads(enabled=True)  # clean up after an unclean exit
        log("Watching for Steam Remote Play")
        try:
            while True:
                self.step()
                time.sleep(POLL_SECONDS)
        finally:
            self.set_pads(enabled=True)


def main():
    home = Path.home()
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--config", type=Path,
                        default=home / ".config/remote-play-pad-guard/devices",
                        help="file listing USB IDs, one per line (default: %(default)s)")
    parser.add_argument("--print-udev-rule", action="store_true",
                        help="print the udev rule for the listed devices and exit")
    parser.add_argument("--steam-dir", type=Path, default=home / ".local/share/Steam",
                        help="Steam folder that contains logs/ (default: %(default)s)")
    parser.add_argument("--usb-dir", type=Path, default=Path("/sys/bus/usb/devices"),
                        help=argparse.SUPPRESS)  # for tests
    parser.add_argument("--pid-file", type=Path, default=home / ".steam/steam.pid",
                        help="Steam's PID file (default: %(default)s)")
    parser.add_argument("--pending-timeout", type=float, default=PENDING_TIMEOUT,
                        help="seconds to wait for an accepted stream to start "
                             "(default: %(default)s)")
    args = parser.parse_args()

    devices = read_devices(args.config)
    if args.print_udev_rule:
        print_udev_rule(devices)
        return

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        Guard(devices, args.steam_dir, args.usb_dir, args.pid_file,
              args.pending_timeout).run()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
